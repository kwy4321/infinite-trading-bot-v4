# ============================================================
# Infinite Trading Bot v4 — .env (필요한 것만)
# 값은 본인 키로 채운 뒤 Cloud Shell → bash scripts/cloudshell_bot.sh restart
# ============================================================

# --- Toss 실거래 (필수) ---
# WTS → 설정 → Open API — Client ID / Secret (둘 다 tsck_live_… 로 시작 가능, 값은 서로 다름)
# TOSS_CLIENT_ID=tsck_live_…
# TOSS_CLIENT_SECRET=tsck_live_…
# 별칭: TOSS_API_KEY / TOSS_SECRET_KEY 도 인식
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=1

# --- Telegram (필수) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- 거래 모드: false=LIVE, true=DRY 시뮬레이션 ---
DRY_RUN=false

# --- 아침 브리핑 AI (Gemini) — 아래 중 하나만 ---
# Optional — Gemini 모델 (비우면 gemini-2.5-flash → 3.5-flash 순 자동 시도)
# SUMMARIZER_MODEL=gemini-2.5-flash
SUMMARIZER_API_KEY=
# GOOGLE_API_KEY=          ← SUMMARIZER 대신 써도 됨 (둘 다 넣을 필요 없음)

# --- Google Sheets 장부 (쓸 때만 아래 3줄 추가) ---
# GOOGLE_SHEETS_ENABLED=true
# GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/스프레드시트ID/edit
# GOOGLE_SERVICE_ACCOUNT_JSON=data/google-service-account.json

# --- Streamlit 대시보드 (쓸 때만) ---
# STREAMLIT_URL=http://VM공인IP:8501
# STREAMLIT_PASSWORD=          ← 비우면 비밀번호 없음

# ============================================================
# 넣지 않아도 되는 것 (코드 기본값 사용)
# BRIEFING_ENABLED, LOG_LEVEL, BACKUP_*, MAX_SPLIT_LOG 등
# ============================================================
# 삭제해도 되는 것 (이 봇에서 미사용·중복)
# NEWS_API_KEY          — 사용 안 함 (뉴스는 Google RSS)
# GEMINI_API_KEY        — SUMMARIZER_API_KEY 와 중복
# GOOGLE_API_KEY        — SUMMARIZER 쓰면 중복
# GOOGLE_SPREADSHEET_ID — GOOGLE_SHEETS_URL 쓰면 중복
