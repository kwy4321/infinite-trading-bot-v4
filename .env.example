# Toss Securities Open API
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# true = API 주문 없이 시뮬레이션 | false + Toss 키 = LIVE (기본: false)
DRY_RUN=false

# --- GCP e2-micro / 무료 티어 (디스크·RAM 절약) ---
LOG_LEVEL=WARNING
BACKUP_ENABLED=true
BACKUP_KEEP=5
BRIEFING_ENABLED=true
MAX_SPLIT_LOG=30
MAX_COMPLETED_CYCLES=50

# Optional (BRIEFING_ENABLED=true 일 때 — Gemini/OpenAI)
# GOOGLE_API_KEY = Gemini 브리핑 AI용 (Sheets 장부와 별개)
# Sheets 장부 = GOOGLE_SHEETS_URL + data/google-service-account.json
SUMMARIZER_API_KEY=
GOOGLE_API_KEY=

# --- Streamlit dashboard ---
STREAMLIT_URL=http://127.0.0.1:8501
STREAMLIT_PASSWORD=

# --- Google Sheets ledger (장부) ---
# GOOGLE_SHEETS_URL 에 스프레드시트 전체 주소만 넣어도 ID 자동 추출
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEETS_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=data/google-service-account.json
